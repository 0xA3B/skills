#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: extract-chat-instructions [--copy]

Print plugins/writing/chatbot-instructions.md, for pasting into a chat app's persistent
instructions. Warn on stderr when it exceeds 5,000 characters, ChatGPT's custom-instructions limit
on paid plans.

Options:
  --copy    Copy the file to the macOS clipboard with pbcopy
  -h        Show this help text
  --help    Show this help text
USAGE
}

copy_mode=0

while (($# > 0)); do
  case "$1" in
    --copy)
      copy_mode=1
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n' "$1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
instructions_file="$script_dir/../plugins/writing/chatbot-instructions.md"
limit=5000

if [[ ! -f "$instructions_file" ]]; then
  printf 'Chatbot instructions not found: %s\n' "$instructions_file" >&2
  exit 1
fi

length="$(wc -m < "$instructions_file" | tr -d ' ')"
if ((length > limit)); then
  printf 'Warning: %s is %s characters, over the %s-character limit.\n' \
    "$instructions_file" "$length" "$limit" >&2
fi

if ((copy_mode)); then
  if ! command -v pbcopy >/dev/null 2>&1; then
    printf 'pbcopy is required for --copy mode.\n' >&2
    exit 1
  fi
  pbcopy < "$instructions_file"
else
  cat "$instructions_file"
fi
