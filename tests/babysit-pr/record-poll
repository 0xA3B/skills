#!/usr/bin/env bash
# Record a poll script's GitHub reads from a real pull request as a replay fixture for the
# babysit-pr poll tests. The script runs as usual, with real sleeps, while the fake gh
# passes each call to the real gh and saves one snapshot per elapsed sleep.
#
# Usage: record-poll <fixture.json> <poll-script> <script-args...>
#   Example: REPO=0xA3B/skills tests/babysit-pr/record-poll \
#     tests/babysit-pr/fixtures/codex-clean.json \
#     plugins/git/skills/babysit-pr/scripts/poll-codex.sh 293 60 3
# Run unsandboxed: the real gh needs the keyring. The fixture holds public pull-request data
# trimmed to the fields the scripts read; review it before committing. Exits with the script's
# status, so a recording whose run ended in an observation failure (6) does not pass as clean.
set -euo pipefail
out="${1:?fixture path}"
script="${2:?poll script}"
shift 2
real_gh="$(command -v gh)"
real_sleep="$(command -v sleep)"
here="$(cd "$(dirname "$0")" && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT
mkdir "${work}/bin"
printf '#!/bin/sh\nexec node "%s" "$@"\n' "${here}/fake-gh.mjs" >"${work}/bin/gh"
# shellcheck disable=SC2016 # $FAKE_GH_DIR and $n expand when the wrapper runs.
printf '#!/bin/sh\nn=$(cat "$FAKE_GH_DIR/clock" 2>/dev/null || echo 0)\necho $((n + 1)) >"$FAKE_GH_DIR/clock"\nexec "%s" "$@"\n' \
  "${real_sleep}" >"${work}/bin/sleep"
chmod +x "${work}/bin/gh" "${work}/bin/sleep"
rc=0
FAKE_GH_DIR="${work}" FAKE_GH_REAL="${real_gh}" PATH="${work}/bin:${PATH}" "${script}" "$@" || rc=$?
cp "${work}/scenario.json" "${out}"
echo "recorded ${out}; the script exited ${rc}"
exit "${rc}"
