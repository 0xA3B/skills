{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- \"$CLAUDE_PROJECT_DIR\"/scripts/claude-worktree-hook create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- \"$CLAUDE_PROJECT_DIR\"/scripts/claude-worktree-hook remove"
          }
        ]
      }
    ]
  }
}
