{
  "name": "skills",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm format:check && pnpm format:shell:check && pnpm lint && pnpm lint:shell && pnpm typecheck && pnpm test && pnpm lint:plugins && pnpm lint:plugin-versions && pnpm lint:commits",
    "eval:trigger": "node --import tsx src/trigger-evals/cli.ts",
    "eval:trigger:marketplace": "node --import tsx src/trigger-evals/cli.ts --marketplace",
    "eval:trigger:plugin": "node --import tsx src/trigger-evals/cli.ts --plugin",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "format:local": "oxfmt .local/*.md .local/*/*.md --write --no-error-on-unmatched-pattern",
    "format:local:check": "oxfmt .local/*.md .local/*/*.md --check --no-error-on-unmatched-pattern",
    "format:shell": "git ls-files -z | xargs -0 shfmt -f=0 | xargs -0 shfmt --write",
    "format:shell:check": "git ls-files -z | xargs -0 shfmt -f=0 | xargs -0 shfmt --diff",
    "install:clean": "pnpm ci",
    "install:frozen": "pnpm install --frozen-lockfile",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:commits": "./scripts/lint-commits",
    "lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix",
    "lint:plugin-versions": "node --import tsx src/plugin-versions/cli.ts",
    "lint:plugins": "node --import tsx src/lint-plugins/cli.ts",
    "lint:shell": "git ls-files -z | xargs -0 shfmt -f=0 | xargs -0 shellcheck",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worktree:add": "./scripts/worktree-add",
    "worktree:remove": "./scripts/worktree-remove",
    "writing:extract-chat-instructions": "./scripts/extract-chat-instructions",
    "writing:extract-chat-instructions:copy": "./scripts/extract-chat-instructions --copy"
  },
  "devDependencies": {
    "@commitlint/cli": "<22",
    "@commitlint/config-conventional": "<22",
    "@types/node": "<27",
    "@types/shell-quote": "<2",
    "husky": "<10",
    "lint-staged": "<18",
    "oxfmt": "<1",
    "oxlint": "<2",
    "shell-quote": "<2",
    "tsx": "<5",
    "typescript": "<7",
    "vite": "<9",
    "vitest": "<6",
    "yaml": "<3"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx}": [
      "pnpm exec oxlint --deny-warnings --report-unused-disable-directives --fix",
      "pnpm exec oxfmt --write"
    ],
    "*.{json,jsonc,yaml,yml,md}": "pnpm exec oxfmt --write --no-error-on-unmatched-pattern",
    "{*.sh,**/*.sh,scripts/*,.husky/*}": [
      "shfmt --write",
      "shellcheck"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-leading-blank": [
        2,
        "always"
      ],
      "body-max-line-length": [
        2,
        "always",
        100
      ],
      "footer-leading-blank": [
        2,
        "always"
      ],
      "header-max-length": [
        2,
        "always",
        88
      ],
      "subject-case": [
        0
      ],
      "subject-full-stop": [
        2,
        "never",
        "."
      ]
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12",
      "onFail": "ignore"
    },
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "error"
    }
  }
}
