{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  "schedule": ["* 0-9 * * 5"],
  "minimumReleaseAge": "3 days",
  // Preserve unbounded manifest entries by updating only the lockfile.
  "rangeStrategy": "update-lockfile",
  "labels": ["dependencies"],
  // Workspace seeds under evals/seeds are staged fixture projects, not dependencies of this repo.
  "ignorePaths": ["**/node_modules/**", "**/bower_components/**", "evals/seeds/**"],
  // Run after regular updates so unbounded majors stay in reviewable PRs.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-9 * * 6"]
  },
  // Allow vulnerability alerts to bypass the three-day cooldown.
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    { "matchManagers": ["npm"], "groupName": "npm dependencies" },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm major dependencies"
    },
    { "matchManagers": ["github-actions"], "groupName": "github actions" },
    { "matchManagers": ["nodenv"], "enabled": false },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript", "@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    { "matchManagers": ["npm"], "matchDepTypes": ["engines"], "enabled": false },
    {
      // pnpm enforces the cooldown while regenerating the lockfile.
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    }
  ]
}
